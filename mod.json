{
	"geode": "5.10.1",
	"gd": {
		"win": "2.2081"
	},
	"id": "sennot.slop",
	"name": "slop",
	"version": "v0.3.6",
	"developer": "Sennot",
	"description": "Turn wave parts into exact slope corridors; draw slopes with Ctrl + drag",
	"settings": {
		"enabled": { "type": "bool", "name": "Drawing enabled", "default": true },
		"record": { "type": "bool", "name": "Record wave routes", "default": true },
		"record-editor": { "type": "bool", "name": "Also record editor playtests", "default": false },
		"window": { "type": "float", "name": "Route window (units above/below)", "default": 300, "min": 60, "max": 1000 },
		"fit-tol": { "type": "float", "name": "Fit tolerance", "default": 0.5, "min": 0.1, "max": 10 },
		"wall-scale": { "type": "float", "name": "Wall hitbox scale", "default": 1, "min": 0.3, "max": 2 },
		"clean-deco": { "type": "bool", "name": "Apply removes deco", "default": true },
		"flat-block-id": { "type": "int", "name": "Flat block ID", "default": 1, "min": 1, "max": 10000 },
		"base-rises-right": { "type": "bool", "name": "Unrotated slope rises right", "default": true },
		"wave": { "type": "string", "name": "Drawing: wave", "default": "Auto", "one-of": ["Auto", "Big", "Mini"] },
		"corridor-gap": { "type": "float", "name": "Drawing: corridor gap", "default": 30, "min": 5, "max": 600 },
		"smoothing": { "type": "float", "name": "Drawing: smoothing (px)", "default": 12, "min": 1, "max": 80 },
		"start-snap": { "type": "float", "name": "Drawing: start snap (0 = free)", "default": 0, "min": 0, "max": 30 },
		"max-pieces": { "type": "int", "name": "Drawing: max pieces per stroke", "default": 600, "min": 10, "max": 5000 },
		"trace-color": { "type": "rgba", "name": "Drawing: trace color", "default": [255, 255, 255, 230] },
		"trace-width": { "type": "float", "name": "Drawing: trace width (px)", "default": 2.5, "min": 0.5, "max": 10 }
	}
}
